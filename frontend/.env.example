# archflux-web environment template (SERVICES_SPEC §3).
#   cp frontend/.env.example frontend/.env
#   docker compose -f frontend/compose.yml --env-file frontend/.env up -d --build
# Contains NO secrets — everything here ends up readable in the browser.

# Runtime (container → /config.json). Separate topology: absolute API root.
API_URL=http://localhost:3001/api
# Optional WebSocket origin override (default: derived from API_URL).
#WS_URL=ws://localhost:3001
# Set only for the integrated topology (nginx proxies /api, /ws, OAuth paths).
#API_UPSTREAM=http://server:3001

# Build-time fallbacks (Vite) used when /config.json is absent (static hosting, CDN).
VITE_API_URL=/api
#VITE_WS_URL=
# `npm run dev` proxy target for /api, /ws, /oauth2, /login/oauth2.
#VITE_DEV_API_PROXY=http://localhost:3001

WEB_PORT=8080
