# archflux-api environment template (SERVICES_SPEC §4, §7).
#   cp backend/.env.example backend/.env
#   docker compose -f backend/compose.yml --env-file backend/.env up -d --build
# PLACEHOLDERS / DEV-ONLY values only. Never commit real secrets.

# PostgreSQL owner (runs Flyway migrations) and least-privilege app role.
POSTGRES_DB=archflux
POSTGRES_USER=archflux
POSTGRES_PASSWORD=change-me-owner-password
DB_APP_USER=archflux_app
DB_APP_PASSWORD=change-me-app-password

# Secrets — generate: openssl rand -hex 32 (JWT/webhook), openssl rand -hex 16 (API token).
JWT_SECRET=change-me-openssl-rand-hex-32
API_TOKEN=change-me-openssl-rand-hex-16
#GITHUB_WEBHOOK_SECRET=

# Public URLs (separate topology: SPA and API on different origins, same site).
FRONTEND_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3001/api
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# false for plain-http local dev; MUST be true behind https.
APP_COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=3001
