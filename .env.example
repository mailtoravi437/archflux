# ArchFlux environment template (Agent C). Copy to .env and fill in:
#   cp .env.example .env
# PLACEHOLDERS ONLY — never commit real secrets. Prod values come from your
# secret manager / deployment environment, not this file.

# Owner connection for migrations + default DATABASE_URL assembly.
POSTGRES_DB=archflux
POSTGRES_USER=archflux
POSTGRES_PASSWORD=change-me

# Least-privilege runtime role, self-provisioned on fresh volumes by
# docker/db-init/01-roles.sh. Dev defaults flagged DEV ONLY.
DB_APP_USER=archflux_app
DB_APP_PASSWORD=dev-app-only

# API connection string (overrides the assembled default in compose.yml).
# The API should use the least-privilege archflux_app role here (see db/roles.sql).
DATABASE_URL=postgresql://archflux:change-me@db:5432/archflux

# Static service credential: accepted ONLY on POST /api/v1/sync/webhook/git.
# It authenticates NOBODY as a user (Phase 1, PROD-001). Dev default shown.
API_TOKEN=change-me-token

# GitHub webhook HMAC secret (Phase 2, PRODUCTIZATION_SPEC §10). Empty =
# webhook endpoint fail-closed. Generate with: openssl rand -hex 32.
# Must match the secret configured in the GitHub App / repository webhook.
#GITHUB_WEBHOOK_SECRET=change-me-webhook-secret

# Redis: NO vars needed — server reaches it via service DNS (REDIS_HOST=redis
# in compose.yml; port/db defaults apply). No published ports.

# Session cookie security: false for local dev (plain http), MUST be true in
# prod (https). Wired to the server via compose.yml.
APP_COOKIE_SECURE=false

# JWT signing secret. REQUIRED in prod — the server refuses to boot under the
# prod profile with a missing/placeholder value (fail-fast, PROD-001). Local
# dev falls back to a non-production placeholder; never rely on it.
JWT_SECRET=change-me-jwt-secret

# Migration posture (Phase 1): Flyway runs automatically at server boot AS THE
# OWNER (SPRING_FLYWAY_USER/PASSWORD = POSTGRES_* in compose.yml) so
# pgcrypto/citext extensions can install. Future tightening: run migrations
# under a dedicated migrator role instead of the owner (see DEPLOY.md).

# SSO (Release D — NOT functional by default). The server ships DEV-ONLY
# placeholder SAML material (server/src/main/resources/sso-dev/, clearly
# marked) so boot never depends on operator SSO config. Real SSO requires:
#SAML_ENTITY_ID=https://archflux.example.com
#SAML_PRIVATE_KEY_LOCATION=/run/secrets/saml-sp.key
#SAML_CERT_LOCATION=/run/secrets/saml-sp.crt
#SAML_IDP_ENTITY_ID=https://your-idp.example.com
#SAML_IDP_SSO_URL=https://your-idp.example.com/sso/saml
#SAML_IDP_SLO_URL=https://your-idp.example.com/slo/saml
#SAML_IDP_CERT_LOCATION=/run/secrets/saml-idp.crt
# (Same pattern for OAuth2/OIDC: GITHUB_/GOOGLE_/OIDC_ client id/secret.)

# Frontend API base: same-origin /api (nginx proxy) by default.
VITE_API_URL=/api

# Optional port overrides (defaults shown):
#WEB_PORT=8080
#SERVER_PORT=3001
#POSTGRES_PORT=5432
#NODE_ENV=production
