<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Structured JSON logging with correlation ID support -->
  <property name="LOG_PATTERN"
    value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{36} - %msg%n"/>
  <property name="JSON_PATTERN"
    value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %X{correlationId} [%thread] %-5level %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <timestamp>
          <timeZone>UTC</timeZone>
        </timestamp>
        <logLevel/>
        <loggerName/>
        <threadName/>
        <message/>
        <mdc/>
        <arguments/>
        <stackTrace/>
      </providers>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <logger name="com.archflux" level="DEBUG"/>
  <logger name="org.springframework.web" level="WARN"/>
  <logger name="org.hibernate" level="WARN"/>
</configuration>