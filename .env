# ArchFlux environment template (Agent C). Copy to .env and fill in:
#   cp .env.example .env
# PLACEHOLDERS ONLY — never commit real secrets. Prod values come from your
# secret manager / deployment environment, not this file.

# Owner connection for migrations + default DATABASE_URL assembly.
POSTGRES_DB=archflux
POSTGRES_USER=archflux
POSTGRES_PASSWORD=d5150374db41aa7b1bf23957bb3294c56d9bb94e7ef3e4358b4021ba96658c56

# API connection string (overrides the assembled default in compose.yml).
# The API should use the least-privilege archflux_app role here (see db/roles.sql).
DATABASE_URL=postgresql://archflux_app:K/aoUfN7OxZlq5x9AY43IdtruUYuOhjl@db:5432/archflux

# Bearer token for `Authorization: Bearer <token>` (dev default: f506189f13b9ff61e04350a8bd983008).
API_TOKEN=f506189f13b9ff61e04350a8bd983008

# App role credentials (least-privilege for API runtime)
DB_APP_USER=archflux_app
DB_APP_PASSWORD=K/aoUfN7OxZlq5x9AY43IdtruUYuOhjl
JWT_SECRET=d5150374db41aa7b1bf23957bb3294c56d9bb94e7ef3e4358b4021ba96658c56
APP_COOKIE_SECURE=true

# Frontend API base: same-origin /api (nginx proxy) by default.
VITE_API_URL=/api

# Optional port overrides (defaults shown):
#WEB_PORT=8080
#SERVER_PORT=3001
#POSTGRES_PORT=5432
#NODE_ENV=production
