# /opt/archflux/.env on the EC2 instance (SERVICES_SPEC §7, §10). root:root 600.
# Placeholders only. Generate every secret with: openssl rand -hex 32
# Never commit the real file; CI never sees these values.

# --- Public endpoint -------------------------------------------------------
# DNS A record must point at the stack's Elastic IP before first start
# (Let's Encrypt validates over HTTP).
APP_DOMAIN=archflux.example.com
ACME_EMAIL=ops@example.com

# --- Images (ECR) -----------------------------------------------------------
# <account>.dkr.ecr.<region>.amazonaws.com — CloudFormation output EcrRegistry.
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
AWS_REGION=us-east-1
# API_IMAGE_TAG / WEB_IMAGE_TAG are managed by remote-deploy.sh in images.env.

# --- Database (owner runs Flyway; app role is DML-only) --------------------
POSTGRES_DB=archflux
POSTGRES_USER=archflux
POSTGRES_PASSWORD=change-me
DB_APP_USER=archflux_app
DB_APP_PASSWORD=change-me

# --- API secrets ------------------------------------------------------------
API_TOKEN=change-me
JWT_SECRET=change-me
# GitHub webhook HMAC; empty = webhook endpoint fail-closed.
GITHUB_WEBHOOK_SECRET=

# --- Magic-link email (resend | sendgrid) ----------------------------------
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@archflux.example.com
RESEND_API_KEY=change-me
#SENDGRID_API_KEY=

# --- Optional sign-in providers (omit to keep them disabled) ---------------
# Redirect URI to register: https://<APP_DOMAIN>/login/oauth2/code/<github|google|oidc>
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# --- Phone sign-in via Firebase Authentication (R1-SEC-02) -------------------
# All values are PUBLIC identifiers (not secrets); no service-account key is needed.
# Values below are the archflux-89085 project's public web config; blank them to keep phone sign-in off. In the Firebase console the Phone provider must be
# enabled and APP_DOMAIN listed under Authentication > Settings > Authorized domains.
# Backend: verifies Firebase ID tokens for this project id.
FIREBASE_PROJECT_ID=archflux-89085
# Web container: written into /config.json at start (no rebuild). FIREBASE_API_KEY switches the
# Phone tab and the reCAPTCHA CSP entries on; it then needs AUTH_DOMAIN, PROJECT_ID and APP_ID.
FIREBASE_API_KEY=AIzaSyAPsB8nWYxy78BCsk63wLdnF0yAjYt8bng
FIREBASE_AUTH_DOMAIN=archflux-89085.firebaseapp.com
FIREBASE_APP_ID=1:1093372892468:web:7adf405d6cffdbb4af4161
FIREBASE_MESSAGING_SENDER_ID=1093372892468
