# /etc/archflux/backend.env  (root:root, chmod 600 — consumed by systemd EnvironmentFile)
# Copy to /etc/archflux/backend.env and fill in real values. Never commit this file.
# INSTRUCTIONS FOR PRODUCTION:
# 1. Replace all placeholder values below with real secrets.
# 2. JWT_SECRET: generate with `openssl rand -hex 32`
# 3. DB_PASSWORD: generate with `openssl rand -base64 24`
# 4. APP_API_TOKEN: generate with `openssl rand -hex 16`
# 5. GITHUB_WEBHOOK_SECRET: generate with `openssl rand -hex 32` or leave empty if webhook not active.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=3001

# PostgreSQL (set DATABASE_URL or split credentials)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/archflux
SPRING_DATASOURCE_USERNAME=archflux_app
SPRING_DATASOURCE_PASSWORD=6TdIPM0JGuJlt/97yQ1zvZyNw52B8PFv

# Static token accepted on POST /api/v1/sync/webhook/git (PROD-001)
APP_API_TOKEN=d0a83ef72e5fc6ac93086d5f0f4d9668

# JWT signing secret — REQUIRED in prod; the server fails fast on a placeholder.
JWT_SECRET=80351ba5a22b4298f02d96cd8512f03a8119afa58031273ce94e684a1336b844

APP_COOKIE_SECURE=true
REDIS_HOST=127.0.0.1

# GitHub webhook HMAC secret (empty = webhook endpoint fail-closed)
GITHUB_WEBHOOK_SECRET=ce9c122e6725e07f328a1dd3e9026ca01040da5b315730bca9921278e90f7636
