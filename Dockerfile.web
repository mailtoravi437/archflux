# syntax=docker/dockerfile:1

# ArchFlux web image (Agent C): build the Vite frontend, serve it via nginx,
# reverse-proxy /api/ to the API service. No localhost baked in — same-origin
# /api by default, overridable at build time (VITE_API_URL) and at runtime
# (/config.json generated from $API_URL, consumed by Phase-2 frontend wiring).

# ---- Stage 1: build the SPA -------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app

# Same-origin default: the nginx proxy serves the API under /api/.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json .oxlintrc.json ./
COPY public ./public
COPY src ./src
RUN npm run build

# ---- Stage 2: nginx runtime --------------------------------------------
FROM nginx:alpine AS runtime

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/config-json.sh /docker-entrypoint.d/20-config-json.sh
# .sh snippets in /docker-entrypoint.d must be executable or nginx ignores them
# (RUN chmod: portable across legacy builder and BuildKit).
RUN chmod 0755 /docker-entrypoint.d/20-config-json.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

# Exec form: nginx receives SIGTERM/SIGQUIT directly for graceful shutdown.
CMD ["nginx", "-g", "daemon off;"]
